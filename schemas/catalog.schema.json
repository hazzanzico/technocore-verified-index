{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hazzanzico/technocore-verified-index/blob/main/schemas/catalog.schema.json",
  "title": "Technocore Verified Index catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projects"],
  "properties": {
    "version": { "const": 1 },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "category", "summary", "platforms", "tags"],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9._-]{1,100}$"
        },
        "category": {
          "enum": ["applications", "automation", "clients", "guides", "monitoring", "testing", "verification"]
        },
        "summary": { "type": "string", "minLength": 20, "maxLength": 240, "pattern": "\\.$" },
        "platforms": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/label" } },
        "tags": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/label" } },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "protocol_path": { "type": "string", "minLength": 1, "maxLength": 240 },
            "live_record": { "type": "string", "format": "uri", "pattern": "^https://technocore\\.chat/humans#r/" }
          }
        }
      }
    }
  }
}
