{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hazzanzico/technocore-verified-index/blob/main/schemas/report.schema.json",
  "title": "Technocore Verified Index report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "methodology_version", "generated_at", "project_count", "projects"],
  "properties": {
    "schema": { "const": "technocore-verified-index-report-v2" },
    "methodology_version": { "const": "2.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "project_count": { "type": "integer", "minimum": 0 },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "category", "summary", "platforms", "tags", "observation", "coverage"],
        "properties": {
          "repo": { "type": "string" },
          "category": { "type": "string" },
          "summary": { "type": "string" },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "observation": { "type": "object" },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["percentage", "label", "present", "observed", "total", "checks"],
            "properties": {
              "percentage": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
              "label": { "enum": ["complete", "strong", "partial", "limited", "incomplete", "unavailable"] },
              "present": { "type": "integer", "minimum": 0, "maximum": 10 },
              "observed": { "type": "integer", "minimum": 0, "maximum": 10 },
              "total": { "const": 10 },
              "checks": {
                "type": "array",
                "minItems": 10,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": ["id", "group", "label", "description", "points", "state", "passed", "awarded"],
                  "properties": {
                    "state": { "enum": ["present", "missing", "unavailable"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
